# Rename File Ini Dari .env.example -> .env

# Ambil di https://aistudio.google.com/apikey -> login Google -> klik "Create API key"
GEMINI_API_KEY=

# (Opsional) | Ambil di https://openrouter.ai/keys -> klik "Create Key"
OPENROUTER_API_KEY=

# (Opsional) | Daftar di https://api.betabotz.eu.org/
BETABOTZ_API_KEY=

# Ambil di https://discord.com/developers/applications -> tab "Bot" -> "Reset Token" (aktifkan Message Content Intent)
DISCORD_BOT_TOKEN=

# Aktifkan Developer Mode di Settings Discord -> klik kanan channel kontrol -> "Copy Channel ID"
DISCORD_CHANNEL_ID=

# (Opsional) | Login https://www.tiktok.com -> tekan F12 -> Application -> Cookies -> salin value "sessionid" 
TIKTOK_SESSION_ID=

# (Opsional) | Login https://www.tiktok.com -> tekan F12 -> Application -> Cookies -> salin value "tt-target-idc" 
TIKTOK_TARGET_IDC=

# (Opsional) | Login https://www.tiktok.com -> tekan F12 -> Application -> Cookies -> salin value "tt-target-idc_sign" 
TIKTOK_TARGET_IDC_SIGN=

# Isi username TikTok host tanpa tanda "@" (contoh: 429.fr_)
TIKTOK_USERNAME=

# Ambil dari https://www.eulerstream.com/
EULERSTREAM_API_KEY=
TIKTOK_WS_AUTH=auto
WHITELIST_AUTHENTICATED_SESSION_ID_HOST=api.eulerstream.com